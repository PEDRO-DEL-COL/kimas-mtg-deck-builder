# Copy to .env and adjust. Never commit the real .env file.

# --- Backend ---
# One of: development, production
ENVIRONMENT=development
# Local SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./kimas.db
# Local Postgres from docker-compose (compose overrides DATABASE_URL automatically
# for the api/worker services; this example is for running the API on the host):
# DATABASE_URL=postgresql+psycopg://kimas:change-me@localhost:5432/kimas
# Supabase Postgres (production target) - paste your connection string with your DB password into your local .env only:
# DATABASE_URL=postgresql+psycopg://postgres.mmkzcrrfonqxezccnomb:<YOUR-DB-PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173"]

# Scryfall bulk data type: oracle_cards (recommended, one entry per card) or default_cards
SCRYFALL_BULK_TYPE=oracle_cards
# Directory for downloaded Scryfall bulk files (relative to the working dir; gitignored)
SCRYFALL_DATA_DIR=data/scryfall
# User-Agent sent to Scryfall (required by their API policy)
SCRYFALL_USER_AGENT=KimasMTGDeckBuilder/0.2 (+https://github.com/PEDRO-DEL-COL/kimas-mtg-deck-builder)
# Identify yourself politely when fetching LigaMagic; only scrape after checking ToS/robots.txt
LIGAMAGIC_USER_AGENT=KimasMTGDeckBuilder/0.2 (+https://github.com/PEDRO-DEL-COL/kimas-mtg-deck-builder)
# Minimum delay between LigaMagic requests, in seconds
LIGAMAGIC_MIN_DELAY_SECONDS=5

# --- docker-compose (local Postgres) ---
POSTGRES_USER=kimas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kimas

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Supabase client (project mmkzcrrfonqxezccnomb) ---
SUPABASE_URL=https://mmkzcrrfonqxezccnomb.supabase.co
SUPABASE_ANON_KEY=
